{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/vertical-search",
      "destination": "/vertical-search/index.html"
    },
    {
      "source": "/vertical-search/",
      "destination": "/vertical-search/index.html"
    },
    {
      "source": "/vertical-search/images/:path*",
      "destination": "/vertical-search/images/:path*"
    },
    {
      "source": "/_next/image",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "(?<path>.*)"
        }
      ],
      "destination": "/:path"
    }
  ]
}
